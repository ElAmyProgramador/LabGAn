cabal-version:          3.0
name:                   LabGAn
version:                0.2.0.0
synopsis:
    Biblioteca para trabajar con objetos de la geometría analítica, llevado a cabo de acuerdo a un curso universitario.
homepage:               https://github.com/ElAmyProgramador/LabGAn

-- description:
license:                MIT
license-file:           LICENSE
author:                 E. Alexeiv Rosales Guillen (Psykokwak, Amy)
maintainer:             da4amy@ciencias.unam.mx
-- copyright:
category:               Math
build-type:             Simple
extra-doc-files:        CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:             warnings
    exposed-modules:    Geometria
                        Geometria.Tipos
                        Geometria.Punto
                        Geometria.Segmento
                        Geometria.Poligono
    -- other-modules:
    -- other-extensions:
    build-depends:      base ^>=4.20.2.0
    hs-source-dirs:     src
    default-language:   GHC2021

test-suite LabGAn-test
    import:             warnings
    default-language:   GHC2021
    -- other-modules:
    -- other-extensions:
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-depends:
        base ^>=4.20.2.0,
        LabGAn
